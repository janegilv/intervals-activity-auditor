# Copy to .env and fill in. Only the Intervals.icu settings are required;
# everything else shows its default and can stay commented out.

# --- Intervals.icu (required to sync) ---
INTERVALS_API_KEY=your_api_key_here
INTERVALS_ATHLETE_ID=your_athlete_id_here

# --- Sync ---
# Recent window fetched on every run, in days.
#REFRESH_DAYS=30
# How often the whole history is fetched (catches edits/deletions of old activities).
#FULL_SYNC_INTERVAL_HOURS=24
#REQUEST_TIMEOUT_SECONDS=30

# --- Storage and logs (relative paths are relative to the project directory) ---
# Database (auditor.sqlite), logs/ and the lock file.
#DATA_DIR=data
# Where report.md/json/csv are written.
#OUTPUT_DIR=output
# Log file level: TRACE, DEBUG, INFO, WARNING or ERROR.
#LOG_LEVEL=INFO

# --- Monitor and notifications ---
# Comma separated: pushover, discord, console. Empty = no notifications.
NOTIFIERS=
# An issue must have been open this long before it's notified.
#NOTIFY_AFTER_MINUTES=60
# Warn once if syncing has been failing this long.
#HEALTH_ALERT_AFTER_HOURS=6

# Pushover (https://pushover.net): your user key, and the token of an
# application you create there ("Create an Application/API Token").
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
# Only send to this device (optional).
#PUSHOVER_DEVICE=

# Discord: channel settings -> Integrations -> Webhooks -> New Webhook.
#DISCORD_WEBHOOK_URL=

# --- Strava (optional): fills in Strava-only activities. See strava_auth_setup.py. ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
